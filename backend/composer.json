{
    "name": "webhatchery/blacksmith-forge-backend",
    "description": "PHP backend for Blacksmith Forge incremental game",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": [
            "@putenv COMPOSER_PROCESS_TIMEOUT=0",
            "php -S localhost:8000 -t public/"
        ],
        "test": "@php scripts/runTests.php",
        "cs-check": "@php scripts/csCheck.php",
        "cs-fix": "@php scripts/csCheck.php"
    },
    "config": {
        "process-timeout": 0
    }
}
